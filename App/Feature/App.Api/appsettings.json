{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Jwt": {
    "Issuer": "App",
    "Audience": "App",
    "SigningKey": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "GlobalPermitLimit": 100,
    "GitHubPermitLimit": 10
  },
  "GitHub": {
    "BaseAddress": "https://api.github.com/",
    "UserAgent": "AspireForge-App",
    "MaxPages": 25
  },
  "GitHubReports": {
    "CacheDuration": "00:10:00",
    "MaxHistoryItems": 100,
    "MaxRelationshipSize": 2000
  }
}
