<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AspireForge.Core\AspireForge.Core.csproj" />
    <ProjectReference Include="..\AspireForge.Analyzers\AspireForge.Analyzers.csproj" />
    <ProjectReference Include="..\AspireForge.Generators\AspireForge.Generators.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>aspireforge</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>aspireforge</ToolCommandName>
    <PackageId>AspireForge</PackageId>
    <Authors>Muhammad Asif Nawaz</Authors>
    <Description>Production-readiness tooling for ASP.NET Core APIs: generate a clean-architecture solution, add production concerns (database, caching, telemetry, authentication, Docker), and audit any project against security, reliability, observability, testing, architecture, performance and deployment rules, with text, JSON, Markdown and SARIF output for CI.</Description>
    <PackageTags>aspnetcore;webapi;production-readiness;linter;static-analysis;clean-architecture;scaffolding;sarif;dotnet-tool</PackageTags>
    <PackageProjectUrl>https://github.com/Asif-Nawaz27/dotnet_aspire_forge</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Asif-Nawaz27/dotnet_aspire_forge</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
