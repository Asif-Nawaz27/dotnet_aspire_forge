<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AspireForge.Core\AspireForge.Core.csproj" />
    <ProjectReference Include="..\AspireForge.Analyzers\AspireForge.Analyzers.csproj" />
    <ProjectReference Include="..\AspireForge.Generators\AspireForge.Generators.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>aspireforge</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>aspireforge</ToolCommandName>
    <PackageId>AspireForge</PackageId>
    <Version>0.1.0</Version>
    <Authors>Muhammad Asif Nawaz</Authors>
    <Description>Opinionated .NET Aspire project scaffolding and analysis CLI.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
